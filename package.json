{
  "name": "assessment-helper-capstoneutd",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "jobs:email": "node --import ./scripts/server-loader.mjs --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/email-worker.ts",
    "jobs:email:once": "npm run jobs:email -- --once",
    "jobs:faculty": "node --import ./scripts/server-loader.mjs --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/scheduler.ts",
    "db:generate": "prisma generate",
    "predev": "prisma generate",
    "prebuild": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:setup": "node scripts/setup-db.mjs",
    "db:seed": "node --env-file-if-exists=.env prisma/seed.mjs",
    "db:seed:preview": "node --env-file-if-exists=.env prisma/seed.mjs --dry-run",
    "db:seed:signups": "node --env-file-if-exists=.env --import ./scripts/server-loader.mjs prisma/seed-signups.mjs",
    "db:seed:signups:preview": "npm run db:seed:signups -- --dry-run"
  },
  "dependencies": {
    "@daypicker/react": "^10.0.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "next": "16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "smtp-mailer": "npm:nodemailer@10.2.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  }
}
