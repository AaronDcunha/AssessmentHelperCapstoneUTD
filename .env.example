# Copy to .env for local development. Never commit .env.
# These settings assume Next.js runs on the host, outside Docker.
POSTGRES_DB=assessment_helper
POSTGRES_USER=assessment_helper
# Replace with a random password. Hex characters avoid URL-encoding issues.
# PostgreSQL uses these credentials when initializing a NEW volume only.
# Editing this value later does not change the existing database password.
POSTGRES_PASSWORD=replace_with_random_hex_password
POSTGRES_PORT=5432

# Keep this URL consistent with the PostgreSQL settings above.
# Percent-encode special characters if using them in the URL credentials.
DATABASE_URL="postgresql://assessment_helper:replace_with_random_hex_password@127.0.0.1:5432/assessment_helper?schema=public"

# Local Mailpit captures messages; it does not deliver them to real inboxes.
# No SMTP credentials or TLS are needed for this local configuration.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Assessment Helper <noreply_course_evaluation@assessmenthelper.edu>"
MAILPIT_UI_PORT=8025

# If Next.js later runs inside Compose, use postgres:5432 and mailpit:1025
# instead of host addresses. Real SMTP settings belong in the deployment env.
# Run npm run jobs:email to deliver queued notifications (or jobs:email:once).
EMAIL_DELIVERY_ENABLED=true

# Optional reserved mock accounts only; seeded database login works with this false.
# Mock accounts also require NODE_ENV=development.
AUTH_DEMO_ENABLED=false
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace_with_a_random_secret
